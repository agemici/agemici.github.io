/* LAB POSITION EKLERİ */

/* RELATIVE CONTAINER */
.card-container {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    margin-top: 50px;
}

/* ANA KART */
.card {
    position: relative;
    width: 400px;
    padding: 30px;
    background: white;
    border-radius: 15px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    overflow: hidden;
    text-align: center;

    /* animasyon */
    animation: float 3s infinite;
}

/* ABSOLUTE ROZETLER */
.badge {
    position: absolute;
    background: #007bff;
    color: white;
    padding: 5px 10px;
    border-radius: 10px;
    font-size: 12px;
    cursor: pointer;
    transition: 0.3s;
}

/* hover efekti */
.badge:hover {
    background: black;
    transform: scale(1.1);
}

/* 3 farklı absolute eleman */
.badge1 {
    top: 10px;
    left: 10px;
    z-index: 2;
}

.badge2 {
    top: 10px;
    right: 10px;
    z-index: 1;
}

.badge3 {
    bottom: 10px;
    left: 10px;
}

/* BUTTON */
.join-btn {
    margin-top: 20px;
    padding: 10px 20px;
    border: none;
    background: green;
    color: white;
    border-radius: 10px;
    cursor: pointer;
    transition: 0.3s;
}

.join-btn:hover {
    background: darkgreen;
    transform: scale(1.1);
}

/* active efekti */
.join-btn:active {
    transform: scale(0.9);
}

/* FIXED ELEMENT */
.fixed-help {
    position: fixed;
    top: 20px;
    right: 20px;
    background: crimson;
    color: white;
    padding: 10px;
    border-radius: 10px;
    cursor: pointer;
    z-index: 999;
}

/* ANİMASYON */
@keyframes float {
    0% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
    100% { transform: translateY(0); }
}

